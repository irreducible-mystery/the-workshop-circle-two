#!/bin/sh
# Circle Two pre-commit hook — chartered in the units verification.
#
# Turns "the gate was consulted and not obeyed" (9a28f25) into "the commit
# cannot proceed". Install once, per clone:
#     git config core.hooksPath .githooks
#
# The Lean-dependent gates need a binary. Export LEAN in your environment, or
# set it for git:
#     git config hooks.leanbin /abs/path/to/lean
LEANBIN=$(git config --get hooks.leanbin 2>/dev/null)
[ -n "$LEANBIN" ] && export LEAN="$LEANBIN"

# The system record's append-only gates — BOTH WIRED, on both seats' words.
# The shipped gate: proposed in the founding letter (SYSTEM-R0-PROVER-REPLY.md,
# 1a3c12b8…), word given in SYSTEM-R0-BUILDER-WIRING-WORD.md (03e9a0a1…).
# The prefix gate: proposed as P2, word given in C4-R2-BUILDER-WORDS.md
# (1fed9f22…) — BESIDE the shipped gate, never instead of it, because the
# two gates' blind spots are disjoint on every mode either seat has planted:
# the shipped gate misses insertion, bullet-deletion and blank-deletion, all
# three of which the prefix gate bites; the prefix gate misses a symlink swap,
# which the shipped gate bites. Measured on both containers.
sh system/audit/s_append_only.sh || exit 1
sh system/audit/s_append_only_p2_candidate.sh || exit 1

exec sh audit/c2_gates.sh
